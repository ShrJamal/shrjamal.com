---
// The desktop's menu bar. Root-relative anchors so the links also work from
// /work/* pages.
const links = [
  { href: "/#services", label: "Services" },
  { href: "/#work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
]
const email = "support@sajam.dev"
---

<!-- Dark in both themes, so text colours here are fixed rather than tokens. -->
<nav
  class="sticky top-0 z-10 flex flex-wrap items-center justify-between gap-x-2 gap-y-1 border-b-2 border-edge bg-bar px-4 py-1.5 text-[13px] text-white sm:text-sm md:px-10"
>
  <!-- Gaps tighten below 380px so everything still fits on one row at 360px. -->
  <div class="flex flex-wrap items-center gap-x-2 min-[380px]:gap-x-3.5 sm:gap-x-6">
    <!-- Wordmark logo set in live text; public/logo.svg is the outlined copy. -->
    <a
      href="/"
      aria-label="SAJAM home"
      class="py-3 text-xl leading-none font-bold tracking-[-0.03em]"
    >
      sajam<span class="text-[#38bdf8]">.</span>
    </a>
    {
      links.map((l) => (
        <a
          href={l.href}
          class="flex min-h-11 items-center transition-colors hover:text-[#7dd3fc]"
        >
          {l.label}
        </a>
      ))
    }
  </div>

  <div class="flex items-center gap-5">
    <a
      href={`mailto:${email}`}
      class="hidden min-h-11 items-center font-mono text-[12.5px] transition-colors hover:text-[#7dd3fc] md:flex"
    >
      {email}
    </a>
    <button
      id="theme-toggle"
      type="button"
      title="Toggle theme"
      aria-label="Toggle theme"
      class="theme-toggle"
    >
      <svg
        class="sun-and-moon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
      >
        <mask
          class="moon"
          id="theme-toggle-moon"
        >
          <rect
            x="0"
            y="0"
            width="100%"
            height="100%"
            fill="white"
          />
          <circle
            cx="24"
            cy="10"
            r="6"
            fill="black"
          />
        </mask>
        <circle
          class="sun"
          cx="12"
          cy="12"
          r="6"
          mask="url(#theme-toggle-moon)"
          fill="currentColor"
        />
        <g
          class="sun-beams"
          stroke="currentColor"
        >
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </g>
      </svg>
    </button>
  </div>
</nav>

<script>
  type Theme = "light" | "dark"

  const btn = document.getElementById("theme-toggle")

  function currentTheme(): Theme {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light"
  }

  function label(theme: Theme) {
    return theme === "dark" ? "Switch to light theme" : "Switch to dark theme"
  }

  // Sync the accessible label with whatever the pre-paint script applied.
  btn?.setAttribute("aria-label", label(currentTheme()))

  btn?.addEventListener("click", () => {
    const next: Theme = currentTheme() === "dark" ? "light" : "dark"
    document.documentElement.dataset.theme = next
    btn.setAttribute("aria-label", label(next))
    try {
      localStorage.setItem("sajam-theme", next)
    } catch {}
  })
</script>
