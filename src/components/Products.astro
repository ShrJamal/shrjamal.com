---
import { Image } from "astro:assets"
import Window from "~/components/Window.astro"
import { products } from "~/lib/projects"
---

<Window
  id="work"
  title="~/work"
  meta={`${products.length} items`}
>
  <div
    class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-2.5 px-[clamp(18px,2.4vw,30px)] pt-6 pb-2.5"
  >
    <h2 class="text-[clamp(28px,3.6vw,46px)] leading-none font-bold tracking-[-0.035em]">
      Things we have built
    </h2>
    <p class="max-w-[46ch] text-[15.5px] leading-[1.55] text-muted">
      Every project here was built end to end, from the first plan to launch: SaaS, healthcare AI,
      developer tools, mobile apps, and content sites.
    </p>
  </div>

  <!-- A file grid: two columns on phones, then as many 250px+ columns as fit. -->
  <div
    class="grid grid-cols-2 gap-2.5 px-[clamp(8px,1.6vw,20px)] pt-2.5 pb-[22px] sm:grid-cols-[repeat(auto-fill,minmax(250px,1fr))]"
  >
    {
      products.map((p) => (
        <a
          href={`/work/${p.slug}`}
          class="flex flex-col gap-2.5 rounded-xl border-2 border-transparent p-2.5 hover:border-edge hover:bg-tile"
        >
          <Image
            src={p.img}
            alt=""
            width={640}
            height={400}
            class="aspect-[16/10] w-full rounded-lg border-2 border-edge object-cover object-top"
          />
          <span class="flex flex-col gap-0.5">
            <span class="text-[17px] font-semibold">{p.name}</span>
            <span class="font-mono text-xs text-muted">{p.category}</span>
            {/* Clamped to keep the grid even; the full text stays in the page for search engines. */}
            <span class="mt-1 line-clamp-3 text-[13.5px] leading-[1.5] text-muted">
              {p.description}
            </span>
          </span>
        </a>
      ))
    }
  </div>
</Window>
