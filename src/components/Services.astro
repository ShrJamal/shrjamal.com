---
// Each icon is the inner markup of a 24px stroke SVG. One shape per icon uses the
// accent colour, echoing the dot in the logo.
const services = [
  {
    n: "01",
    title: "Software development",
    icon: `<path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/><rect x="10.5" y="8.5" width="3" height="7" rx=".75" class="fill-accent stroke-none"/>`,
    body: "From the first technical plan to the version real customers use.",
  },
  {
    n: "02",
    title: "Tech consulting",
    icon: `<path d="M4 4.5h16a1 1 0 0 1 1 1V16a1 1 0 0 1-1 1h-9.5L6 20.5V17H4a1 1 0 0 1-1-1V5.5a1 1 0 0 1 1-1z"/><path d="M7 9h10M7 12.5h4"/><rect x="12.5" y="11" width="2.5" height="3" rx=".6" class="fill-accent stroke-none"/>`,
    body: "Straight answers on architecture, tools, cost, and what is worth building.",
  },
  {
    n: "03",
    title: "Website development",
    icon: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8.5h18M7 13.5h5"/><rect x="13.25" y="12" width="2.5" height="3" rx=".6" class="fill-accent stroke-none"/>`,
    body: "Fast, clear websites that explain the business and make the next step obvious.",
  },
  {
    n: "04",
    title: "Mobile apps",
    icon: `<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/><rect x="10" y="7.5" width="4" height="4" rx="1" class="fill-accent stroke-none"/>`,
    body: "Useful iOS and Android apps, built for the way people use their phones.",
  },
  {
    n: "05",
    title: "Custom solutions",
    icon: `<rect x="3" y="3.5" width="7" height="6" rx="1.5"/><path d="M10 6.5h4a3 3 0 0 1 3 3v5"/><rect x="14" y="14.5" width="7" height="6" rx="1.5" class="fill-accent stroke-accent"/>`,
    body: "Internal tools and automations that cut repetitive work and fit the team.",
  },
]
---

<section id="services" class="border-t border-line px-6 py-20 md:px-14">
  <div class="mb-3 font-mono text-[13px] text-accent">// services</div>
  <h2 class="mb-10 text-[30px] font-bold tracking-[-0.01em] md:text-[38px]">
    How we can help
  </h2>
  <div
    class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-grid-line bg-grid-line sm:grid-cols-2 lg:grid-cols-5"
  >
    {
      services.map((s) => (
        <div class="bg-card px-[22px] py-7">
          <div class="mb-4 flex items-start justify-between">
            <svg
              class="size-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={s.icon}
            />
            <div class="font-mono text-xs text-accent">{s.n}</div>
          </div>
          <h3 class="mb-2 text-[16.5px] font-semibold">{s.title}</h3>
          <p class="text-[13.5px] leading-[1.55] text-muted">{s.body}</p>
        </div>
      ))
    }
  </div>
</section>
