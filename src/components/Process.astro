---
import Window from "~/components/Window.astro"

// How an engagement runs, from first email to after launch.
const steps = [
  {
    n: "01",
    title: "Scope",
    body: "Tell us what you need. We ask the questions that matter, then agree on a written plan with scope, timeline, and price.",
  },
  {
    n: "02",
    title: "Build",
    body: "You see working software early and often, not just status updates, so feedback lands while it is cheap to act on.",
  },
  {
    n: "03",
    title: "Launch",
    body: "We deploy to production, hand over the code and accounts, and document how everything runs.",
  },
  {
    n: "04",
    title: "Support",
    body: "After launch we stay available for fixes, improvements, and the next set of features.",
  },
]
---

<Window
  id="process"
  tone="note"
  title="how-we-work.md"
  meta={`${steps.length} steps`}
  class="mt-[clamp(0px,4vw,56px)] flex-[1_1_340px] rotate-[0.6deg]"
>
  <h2
    class="px-[clamp(18px,2.4vw,28px)] pt-[22px] pb-3.5 text-[clamp(26px,3vw,38px)] leading-none font-bold tracking-[-0.03em]"
  >
    <span
      aria-hidden="true"
      class="font-mono font-medium text-accent"># </span
    >How we work
  </h2>
  <ol class="flex list-none flex-col p-0">
    {
      steps.map((s) => (
        <li class="flex gap-4 border-t border-edge/15 px-[clamp(18px,2.4vw,28px)] py-4">
          <span class="pt-1 font-mono text-[13px] text-accent">{s.n}</span>
          <div>
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="mt-1 text-[14.5px] leading-[1.5] text-muted">{s.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Window>
