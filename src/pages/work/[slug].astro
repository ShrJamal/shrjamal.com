---
import type { GetStaticPaths } from "astro"
import { Image } from "astro:assets"
import Navbar from "~/components/TheNavbar.astro"
import Window from "~/components/Window.astro"
import RootLayout from "~/layouts/RootLayout.astro"
import { type Product, products } from "~/lib/projects"

// One case study page per project, generated at build time.
export const getStaticPaths = (() =>
  products.map((project, i) => ({
    params: { slug: project.slug },
    // Wraps around so the last project links back to the first.
    props: { project, next: products[(i + 1) % products.length] },
  }))) satisfies GetStaticPaths

type Props = { project: Product; next: Product }

const { project, next } = Astro.props
const email = "support@sajam.dev"
---

<RootLayout
  title={`${project.name}: ${project.category} case study | SAJAM`}
  description={project.description}
>
  <Navbar />
  <main
    class="mx-auto flex max-w-[1080px] flex-col gap-[clamp(24px,3vw,40px)] px-[clamp(16px,4vw,64px)] pt-[clamp(24px,4vw,56px)] pb-8"
  >
    <a
      href="/#work"
      class="btn self-start font-mono text-sm"
    >
      ← All work
    </a>

    <!-- The case study itself, opened as a file from ~/work. -->
    <Window
      as="article"
      title={`~/work/${project.slug}.md`}
    >
      <div class="p-[clamp(22px,4vw,52px)]">
        <header class="mb-10">
          <div class="mb-3 font-mono text-[13px] text-accent">{project.category}</div>
          <h1
            class="mb-4 text-[clamp(38px,5.4vw,72px)] leading-[0.98] font-bold tracking-[-0.04em]"
          >
            {project.name}
          </h1>
          <p class="mb-6 max-w-[60ch] text-lg leading-[1.65] text-muted">{project.description}</p>
          {
            project.src ? (
              <a
                href={project.src}
                target="_blank"
                rel="noopener"
                class="btn btn-primary"
              >
                Visit {project.host} ↗
              </a>
            ) : (
              <span class="font-mono text-[13px] text-muted">
                {project.host} is no longer online
              </span>
            )
          }
        </header>

        <Image
          src={project.img}
          alt={`Screenshot of ${project.name}`}
          width={1280}
          class="mb-12 aspect-video w-full rounded-lg border-2 border-edge object-cover object-top"
        />

        <div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_250px]">
          <div class="flex flex-col gap-10">
            <section>
              <h2 class="mb-3 text-[24px] font-bold tracking-[-0.02em]">The problem</h2>
              <p class="text-[16px] leading-[1.75] text-muted">{project.problem}</p>
            </section>

            <section>
              <h2 class="mb-3 text-[24px] font-bold tracking-[-0.02em]">What we built</h2>
              <ul class="flex list-none flex-col gap-2.5 p-0">
                {
                  project.built.map((item) => (
                    <li class="flex gap-3 text-[16px] leading-[1.65] text-muted">
                      <span class="font-mono text-accent">→</span>
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </section>
          </div>

          <aside class="flex flex-col gap-6 self-start rounded-xl border-2 border-edge bg-tile p-6">
            <div>
              <div class="mb-1.5 font-mono text-[11.5px] text-muted">Platform</div>
              <div class="text-[14.5px]">{project.platform}</div>
            </div>
            {
              project.proof && (
                <div>
                  <div class="mb-1.5 font-mono text-[11.5px] text-muted">Traction</div>
                  <div class="text-[14.5px] leading-[1.5]">{project.proof}</div>
                </div>
              )
            }
            <div>
              <div class="mb-2 font-mono text-[11.5px] text-muted">Tags</div>
              <div class="flex flex-wrap gap-1.5 font-mono text-[10.5px] text-accent">
                {
                  project.techs.map((t) => (
                    <span class="rounded-[5px] border border-edge/30 bg-card px-2 py-[3px]">{t}</span>
                  ))
                }
              </div>
            </div>
          </aside>
        </div>
      </div>
    </Window>

    <!-- Two bare windows (no title bar) as the next steps. -->
    <div class="grid grid-cols-1 gap-[clamp(24px,3vw,40px)] md:grid-cols-2">
      <a
        href={`/work/${next.slug}`}
        class="win block p-6"
      >
        <div class="mb-2 font-mono text-[12px] text-muted">Next project →</div>
        <div class="text-xl font-semibold">{next.name}</div>
        <div class="text-[14px] text-muted">{next.category}</div>
      </a>
      <a
        href={`mailto:${email}`}
        class="win win-note block p-6"
      >
        <div class="mb-2 font-mono text-[12px] text-muted">Need something similar?</div>
        <div class="text-xl font-semibold">Tell us what you need</div>
        <div class="font-mono text-[14px] text-accent">{email}</div>
      </a>
    </div>
  </main>
</RootLayout>
