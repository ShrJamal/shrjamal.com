---
import RootLayout from "~/layouts/RootLayout.astro"

// Served by the Cloudflare assets binding for any unknown path
// ("not_found_handling": "404-page" in wrangler.jsonc).
const email = "support@sajam.dev"
---

<RootLayout
  title="Page not found | SAJAM"
  description="The page you are looking for does not exist."
>
  <meta
    slot="head"
    name="robots"
    content="noindex"
  />
  <main
    class="relative flex min-h-[70svh] flex-col justify-center overflow-hidden px-6 py-24 md:px-14"
  >
    <div
      class="absolute inset-0"
      style="background:radial-gradient(700px 350px at 75% 10%,light-dark(rgba(37,99,235,.12),rgba(37,99,235,.28)),transparent 70%)"
    >
    </div>

    <div class="relative max-w-[640px]">
      <div class="mb-4 font-mono text-[13px] text-accent">404</div>
      <h1
        class="mb-4 text-[36px] leading-[1.1] font-bold tracking-[-0.02em] md:text-[48px]"
      >
        This page does not exist
      </h1>
      <p class="mb-8 text-lg leading-[1.65] text-muted">
        The link may be old or mistyped. Head back to the homepage, or email us
        if you were looking for something specific.
      </p>
      <div class="flex flex-wrap items-center gap-3.5">
        <a
          href="/"
          class="btn-cta rounded-[9px] px-[26px] py-[13px] font-semibold no-underline"
        >
          Back to homepage
        </a>
        <a
          href={`mailto:${email}`}
          class="rounded-[9px] border border-btn-line px-[26px] py-[13px] font-mono font-semibold text-inherit no-underline"
        >
          {email}
        </a>
      </div>
    </div>
  </main>
</RootLayout>
