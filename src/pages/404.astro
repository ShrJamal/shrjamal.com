---
import Window from "~/components/Window.astro"
import RootLayout from "~/layouts/RootLayout.astro"

// Served by the Cloudflare assets binding for any unknown path
// ("not_found_handling": "404-page" in wrangler.jsonc).
const email = "support@sajam.dev"
---

<RootLayout
  title="Page not found | SAJAM"
  description="The page you are looking for does not exist."
>
  <meta
    slot="head"
    name="robots"
    content="noindex"
  />
  <main
    class="mx-auto flex min-h-[70svh] max-w-[1400px] flex-col justify-center px-[clamp(16px,4vw,64px)] py-16"
  >
    <!-- Drawn as an error dialog on the desktop. -->
    <Window
      as="div"
      tone="note"
      title="error"
      meta="404"
      class="w-full max-w-[640px] -rotate-[0.5deg] self-center"
    >
      <div class="flex flex-col gap-5 p-[clamp(22px,4vw,40px)]">
        <h1 class="text-[clamp(34px,5vw,52px)] leading-none font-bold tracking-[-0.035em]">
          This page does not exist
        </h1>
        <p class="text-[17px] leading-[1.6] text-muted">
          The link may be old or mistyped. Head back to the homepage, or email us if you were
          looking for something specific.
        </p>
        <div class="mt-1 flex flex-wrap items-center gap-4">
          <a
            href="/"
            class="btn btn-primary"
          >
            Back to homepage
          </a>
          <a
            href={`mailto:${email}`}
            class="btn font-mono text-[15px]"
          >
            {email}
          </a>
        </div>
      </div>
    </Window>
  </main>
</RootLayout>
